# --- Build output (regenerated by IntelliJ; can be large) ---
out/

# --- IntelliJ user-specific churn (keep shared project files: *.iml, .idea/libraries) ---
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/tasks.xml
.idea/dictionaries/
.idea/.name

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Word lock files (open-document temp files inside docs/Exiles Design Documentation/) ---
~$*
