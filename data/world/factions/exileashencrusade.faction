		# Luddic Path blend (CLAUDE.md §4 roster cleanup, 2026-07-07): the ships the
		# Path faithful brought when they joined the Crusade. Variant hull ids verified:
		# lasher_luddic_path_Raider -> hullId lasher_pather; prometheus2_Standard -> prometheus2.
		"lasher_luddic_path_Raider":5,
		"prometheus2_Standard":5,
	},
	# multiplier for how often hulls show up in the faction's fleets
	"hullFrequency":{
		"tags":{
			# Path ships are the minority flavor in a Church-dominant fleet
