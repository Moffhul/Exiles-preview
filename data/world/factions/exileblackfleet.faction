	"ranks":{
		"ranks":{
			"spaceCommander":{"name":"Captain"},
		},
		"posts":{
			"patrolCommander":{"name":"Captain"},
			"fleetCommander":{"name":"Fleet Master"},
			"baseCommander":{"name":"Warboss"},
			"stationCommander":{"name":"Station King"},
			"portmaster":{"name":"Portboss"},
			"administrator":{"name":"Boss"},
		},
	},
	"voices":{
		"LOW":{
			"soldier":3,
			"spacer":10,
		},
		"MEDIUM":{
			"soldier":5,
			"spacer":10,
		},
		"HIGH":{
			"soldier":5,
			"spacer":10,
			"villain":10,
		},
	},

	"custom":{
		"decentralized":true, # prevents faction from offering Security Code and Combat Bounty missions
		"engageWhenEvenStrength":true,
		"exemptFromFoodShortages":true,
		"willTradeWhenHostile":false,
		"ignoreTradeWithEnemiesForReputation":true,
		"postsNoBounties":true,
		"offerMissionsWhenHostile":false,
		"allowsTransponderOffTrade":true,	# pirates take anyone's money at the black market
		"patrolsHaveNoPatrolMemoryKey":true,
		# MIGRATED here from exilemidan per the ratified split: the temp-base spigot is
		# Black Fleet content ("forward supply bases"). The anchor lifecycle script CLOSES
		# this spigot at runtime when both anchors are dead (defeatability guarantee).
		"makesPirateBases":true,
		"pirateBaseStationTypes":{
			"orbitalstation":10,
			"orbitalstation_mid":6,
			"orbitalstation_high":2,
		},
		"fightToTheLast":true, # Mourad's discipline: order a full assault instead of retreating, in most cases
		"hostilityImpactOnGrowth":true,
		"punitiveExpeditionData":{
			"vsCompetitors":false,
			"vsFreePort":true,
			"canBombard":true,
			"territorial":true,
		},
		"simulatorData":{
			"showInSimulator":true,
		},
	},
	"fleetTypeNames":{
		"smallTrader":"Trade Convoy",
		"trade":"Trade Convoy",
		"tradeLiner":"Passenger Convoy",
		"patrolSmall":"Corsair",
		"patrolMedium":"Raiders",
		"patrolLarge":"Armada",
		"mercScout":"Scout",
		"mercBountyHunter":"Raiders",
		"mercPrivateer":"Raiders",
		"mercPatrol":"Attack Fleet",
		"mercArmada":"Armada",
		"taskForce":"Black Armada",
	},
