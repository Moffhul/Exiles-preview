# exileblackfleet.faction — the Black Fleet, Admiral Mourad's Midan-backed pirate armada.
# Created 2026-07-07 per the ratified Midan/Black Fleet split: the pirate identity that
# previously lived inside exilemidan.faction is PROMOTED here (roster/music/portraits/ranks
# carried over); exilemidan is re-identified as the shadowy Midan proper.
#
# DESIGN (CLAUDE.md §4): red-on-red — colors AND flag are deliberately the vanilla Pirates'
# own ([255,0,0], pirates.png): players SHOULD have difficulty telling the Black Fleet from
# ordinary pirates (author ruling 2026-07-07). Toughness comes from the Mysterious Stockpiles
# industry on the two anchor stations (quality via ShipQuality machinery), NOT from a fat
# doctrine — kill both anchors and their fleets degrade to the doctrine baseline below.
{
	id:"exileblackfleet",	# LOAD-BEARING — referenced by sector gen / anchors / lifecycle / director config. Do not change.

	# --- Identity ---------------------------------------------------------------
	"color":[255,0,0,255],			# = vanilla pirates, verbatim (deliberate)
	"baseUIColor":[200,0,0,255],	# = vanilla pirates, verbatim (deliberate)
	"darkUIColor":[85,0,0,175],
	"gridUIColor":[255,0,0,75],
	"brightUIColor":[231,98,103,255],

	"displayName":"Black Fleet",
	"displayNameWithArticle":"the Black Fleet",
	"displayNameLong":"Black Fleet",
	"displayNameLongWithArticle":"the Black Fleet",
	"displayNameIsOrAre":"are",
	"showInIntelTab":true,
	"logo":"graphics/factions/exile_black_fleet.png",
	"crest":"graphics/factions/crest_exile_black_fleet.png",
	"shipNamePrefix":"",
	"shipNameSources":{
		"PIRATES":2,
		"BEASTS":1,
		"NORSE":1,
		"CELTIC":1,
		"SPACE":1,
		"GENERAL":1,
	},
	"names":{
		"fringe":1,
		"modern":1,
		"world":1,
		"future":1,
		"myth":1,
		"old english":1,
		"pirate":2,
	},

	# --- Roster (carried over from the pre-split file: pirate family, unchanged) --
	"variantOverrides":{
	},
	"hullFrequency":{
		"tags":{
			"pirate_bp":2,
		},
		"hulls":{
			"falcon_p":0.5, # it's pretty good, so make it more rare
			"venture":0.3, # it's pretty annoying en masse, so, ditto
			"venture_p":0.5, # it's also potentially annoying if there's too much of them
		},
	},
	"shipsWhenImporting":{
		"tags":["base_bp", "pirate_bp", "pirates"],
		"hulls":[
			"vanguard_pirates",
			"manticore_pirates",
			"falcon_p",
			"eradicator_pirates",
			"atlas2",
		],
	},
	"knownShips":{
		"tags":["base_bp", "pirate_bp", "pirates"],
		"hulls":[
			"vanguard_pirates",
			"manticore_pirates",
			"falcon_p",
			"eradicator_pirates",
			"atlas2",
		],
	},
	"priorityShips":{
		"tags":[],
		"hulls":[
		],
	},
	"knownFighters":{
		"tags":["pirates"],
		"fighters":[
			"broadsword_wing",
			"talon_wing",
			"piranha_wing",
		],
	},
	"priorityFighters":{
		"tags":[],
		"fighters":[
		],
	},
	"knownWeapons":{
		"tags":["base_bp", "lowtech_bp", "midline_bp", "missile_bp", "hightech_bp", "pirates"],
		"weapons":[
			"irautolance",
			"hurricane",
			"squall",
			"locust",
		],
	},
	"priorityWeapons":{
		"tags":[],
		"weapons":[
		],
	},
	"knownHullMods":{
		"tags":["base_bp", "pirates", "standard"],
		"hullMods":[
			"advancedshieldemitter", # accelerated
			"turretgyros",
			"armoredweapons",
			"converted_hangar",
			"magazines",
			"missleracks",
			"frontshield",  # makeshift
			"heavyarmor",
			"insulatedengine",
			"fluxbreakers",
			"shield_shunt",
		],
	},
	"illegalCommodities":[
	],

	# --- Doctrine — "pirates, but tough" BASELINE only ---------------------------
	# shipQuality/officerQuality bumped 1 -> 2 vs the pre-split file (TUNABLE): a cut
	# above pirate rabble even with the anchors dead. The real edge is the Mysterious
	# Stockpiles quality bonus, which dies with the anchors (emergent defeatability).
	"factionDoctrine":{
		"warships":5,
		"carriers":1,
		"phaseShips":1,

		"officerQuality":2,
		"shipQuality":2,
		"numShips":4,

		"shipSize":3,

		"aggression":4,

		"combatFreighterProbability":0.75,
		"combatFreighterCombatUseFraction":1,
		"combatFreighterCombatUseFractionWhenPriority":1,
		"autofitRandomizeProbability":0.75,

		"commanderSkillsShuffleProbability":0,
		"commanderSkills":[
			"crew_training",
			"coordinated_maneuvers"
		],
	},

	# --- A/V (carried over: reads as pirates on purpose) -------------------------
	"music":{
		"theme":"music_pirates_market_neutral",
		"market_neutral":"music_pirates_market_neutral",
		"market_hostile":"music_pirates_market_hostile",
		"market_friendly":"music_pirates_market_friendly",
		"encounter_neutral":"music_pirates_encounter_neutral",
		"encounter_hostile":"music_pirates_encounter_hostile",
		"encounter_friendly":"music_pirates_encounter_friendly",
	},
